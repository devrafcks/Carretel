# ───────────────── App ─────────────────
NEXT_PUBLIC_APP_URL=https://<seu-dominio>.com.br      # dev: http://localhost:3000 (ou https com next dev --experimental-https)
NEXT_PUBLIC_DEFAULT_LOCALE=es                         # decisão A2
NEXT_PUBLIC_BRAND_NAME=Carretel                       # decisão A1

# ───────────────── Banco: Neon Postgres ─────────────────
# Sem DATABASE_URL o app roda com Postgres local embutido (PGlite em .data/pglite) — só para desenvolvimento.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
#   ↑ POOLED (host com "-pooler"): runtime da app (node-postgres + attachDatabasePool)
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
#   ↑ DIRETA (sem "-pooler"): só para drizzle-kit generate/migrate
#   Dica: escolher a região do Neon mais próxima de SP disponível (confirmar no painel)

# ───────────────── Auth (Neon Auth = Managed Better Auth, OTP por e-mail) ─────────────────
NEON_AUTH_BASE_URL=                                   # escrito por `neon deploy` / `neon env pull`
NEON_AUTH_COOKIE_SECRET=                              # openssl rand -base64 32 (32+ caracteres)
# Sem NEON_AUTH_*: login local de desenvolvimento (código na tela e no console). Nunca em produção.
# DEV_AUTH_SECRET=

# E-mail transacional: o Neon Auth envia o OTP (SMTP compartilhado no início; SMTP próprio em produção)
# v1.1, login por telefone:
# WHATSAPP_OTP_PROVIDER_TOKEN=
# WHATSAPP_OTP_SENDER_ID=

# ───────────────── AbacatePay (API v2) ─────────────────
# Sem ABACATEPAY_API_KEY (fora de produção): checkout SIMULADO em /cuenta/pago-simulado
ABACATEPAY_API_KEY=                                   # chave de TESTE em dev/preview, chave de PRODUÇÃO só em Production
ABACATEPAY_WEBHOOK_SECRET=                            # o mesmo secret informado ao criar o webhook (openssl rand -hex 32)
ABACATEPAY_PUBLIC_KEY=                                # chave PÚBLICA fixa publicada na doc de segurança da AbacatePay
ABACATEPAY_PRODUCT_ID_MONTHLY=prod_xxx                # produto R$ 35,00 (3500 centavos), cycle: "MONTHLY", sem trial
ABACATEPAY_PRODUCT_ID_MONTHLY_CARD_TRIAL=             # opcional: mesmo produto com trialDays: 7, só cartão

# ───────────────── Storage de fotos ─────────────────
# MVP: fotos (WebP, sem EXIF) guardadas no Postgres. Vercel Blob/R2 ficam para quando o volume crescer.
BLOB_READ_WRITE_TOKEN=

# ───────────────── Segurança / LGPD ─────────────────
DATA_ENCRYPTION_KEY=                                  # 32 bytes base64 (openssl rand -base64 32): criptografa CPF/RNM
CRON_SECRET=                                          # protege /api/cron/* (Vercel Cron envia no header Authorization)

# ───────────────── Acessibilidade ─────────────────
NEXT_PUBLIC_SEEB_WIDGET_URL=https://seeb-widget.pages.dev/widget.js

# ───────────────── Parâmetros legais ─────────────────
# MINIMUM_WAGE_MONTHLY_CENTS=                         # ⚠️ CONFIRMAR o salário mínimo vigente (decreto) antes de preencher
