# ───────────────── App ─────────────────
NEXT_PUBLIC_APP_URL=https://<seu-dominio>.com.br      # dev: http://localhost:3000 (ou https com next dev --experimental-https)
NEXT_PUBLIC_DEFAULT_LOCALE=es                         # decisão A2
NEXT_PUBLIC_BRAND_NAME=Carretel                       # decisão A1

# ───────────────── Banco: Supabase Postgres ─────────────────
# Sem DATABASE_URL o app roda com Postgres local embutido (PGlite em .data/pglite) — só para desenvolvimento.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#   ↑ POOLER em modo transação (:6543): runtime da app (a Vercel usa este)
DATABASE_URL_UNPOOLED=postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres
#   ↑ DIRETA: só para drizzle-kit migrate (IPv6; rode da sua máquina)
#   Funções da Vercel na mesma região do banco (vercel.json "regions")

# ───────────────── Login (Better Auth próprio, schema app_auth) ─────────────────
BETTER_AUTH_SECRET=                                   # openssl rand -base64 32 (diferente em cada ambiente)
BETTER_AUTH_URL=https://<seu-dominio>                 # opcional: padrão é NEXT_PUBLIC_APP_URL
# Sem BETTER_AUTH_SECRET: login local de desenvolvimento (código na tela e no console). Nunca em produção.
# DEV_AUTH_SECRET=

# E-mail do código de "Esqueci minha senha" (SMTP; padrão Gmail, até ~500/dia, entrega para qualquer endereço)
SMTP_USER=                                            # seuemail@gmail.com
SMTP_PASS=                                            # senha de app do Google (myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM_NAME=Carretel
# v1.1, login por telefone:
# WHATSAPP_OTP_PROVIDER_TOKEN=
# WHATSAPP_OTP_SENDER_ID=

# ───────────────── AbacatePay (API v2) ─────────────────
# Sem ABACATEPAY_API_KEY (fora de produção): checkout SIMULADO em /cuenta/pago-simulado
ABACATEPAY_API_KEY=                                   # chave de TESTE em dev/preview, chave de PRODUÇÃO só em Production
ABACATEPAY_WEBHOOK_SECRET=                            # o mesmo secret informado ao criar o webhook (openssl rand -hex 32)
ABACATEPAY_PUBLIC_KEY=                                # opcional: a chave pública de HMAC já vem no código (doc de segurança da AbacatePay)
ABACATEPAY_PRODUCT_ID_MONTHLY=                        # opcional: se vazio, o app cria o produto "carretel-mensal" (R$ 35, MONTHLY) sozinho
ABACATEPAY_PRODUCT_ID_MONTHLY_CARD_TRIAL=             # opcional: se vazio, o app cria "carretel-mensal-teste-cartao" (trialDays 7)
ABACATEPAY_PIX_AUTOMATICO=                            # on | off — off enquanto a AbacatePay não liberar o Pix Automático na loja

# ───────────────── Storage de fotos ─────────────────
# MVP: fotos (WebP, sem EXIF) guardadas no Postgres. Vercel Blob/R2 ficam para quando o volume crescer.
BLOB_READ_WRITE_TOKEN=

# ───────────────── Segurança / LGPD ─────────────────
DATA_ENCRYPTION_KEY=                                  # 32 bytes base64 (openssl rand -base64 32): criptografa CPF/RNM
CRON_SECRET=                                          # protege /api/cron/* (Vercel Cron envia no header Authorization)

# ───────────────── Acessibilidade ─────────────────
NEXT_PUBLIC_SEEB_WIDGET_URL=https://seeb-widget.pages.dev/widget.js

# ───────────────── Parâmetros legais ─────────────────
# MINIMUM_WAGE_MONTHLY_CENTS=                         # ⚠️ CONFIRMAR o salário mínimo vigente (decreto) antes de preencher


# Painel admin (/admin): e-mails com acesso total, separados por vírgula
ADMIN_EMAILS=
